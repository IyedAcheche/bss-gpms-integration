# GPMS Foresight API (required for background polls and manual FDM ingest)
GPMS_BASE_URL=https://apimx.gpms-vt.com
GPMS_EMAIL=
GPMS_PASSWORD=

# PostgreSQL only — SQLite is not supported
# Docker default (docker-compose.yml): user/pass/db = brazos/brazos/brazos_gpms
DATABASE_URL=postgresql+psycopg2://brazos:brazos@localhost:5432/brazos_gpms

# Background job intervals (seconds). Default 600 = 10 minutes.
HUMS_POLL_INTERVAL_SECONDS=600
FDM_POLL_INTERVAL_SECONDS=600

# Proactive GPMS JWT refresh (days)
GPMS_TOKEN_RENEWAL_DAYS=7

# FDM first backfill: max operations listed per mapped asset (then incremental newimports)
FDM_OPERATIONS_FETCH_LIMIT=500

# Optional deep link in HUMS API responses, e.g. https://portal.example/assets/{asset_id}
GPMS_PORTAL_ASSET_URL=

# Copy to .env when running the app inside Docker Compose (profile: full or deploy).
# Postgres hostname is the compose service name, not localhost.

# Container registry image (no tag). Company-provided repo, e.g. mycompany/brazos-gmps-app
DOCKER_IMAGE=yourorg/brazos-gmps-app

GPMS_BASE_URL=https://apimx.gpms-vt.com
GPMS_EMAIL=
GPMS_PASSWORD=

DATABASE_URL=postgresql+psycopg2://brazos:brazos@postgres:5432/brazos_gpms

HUMS_POLL_INTERVAL_SECONDS=600
FDM_POLL_INTERVAL_SECONDS=600
GPMS_TOKEN_RENEWAL_DAYS=7
FDM_OPERATIONS_FETCH_LIMIT=500
GPMS_PORTAL_ASSET_URL=
